# =============================================================================
# Proyecto-Blockbuster — entorno para el stack multimedia en Podman
# Copia este fichero a `.env` y AJUSTA los valores antes de levantar el stack.
# NUNCA commitear `.env` (solo `.env.example`).
# =============================================================================

# --- Usuario/grupo efectivos dentro de los contenedores (LinuxServer) ---------
# Usa los UID/GID de tu usuario de host para que los hard links funcionen
# correctamente entre bind mounts en rootless Podman.
#   id -u   -> PUID
#   id -g   -> PGID
PUID=1000
PGID=1000

# --- Zona horaria --------------------------------------------------------------
TZ=Europe/Madrid

# --- Volumen único en el host --------------------------------------------------
# Todos los servicios montan subdirectorios de esta ruta. NO usar /downloads y
# /media separados: perderías la capacidad de hacer hard links.
# Ejemplo para Windows: DATA_ROOT=C:/Media
# Ejemplo para Linux:   DATA_ROOT=/data
DATA_ROOT=/var/lib/podman/multimedia

# --- Puertos publicados en el host --------------------------------------------
# Ajusta si alguno choca con otro servicio del host.
JELLYFIN_PORT=8096
SEERR_PORT=5055
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
READARR_PORT=8787
BAZARR_PORT=6767
JACKETT_PORT=9117
TRACEARR_PORT=3000
QBITTORRENT_PORT=9080
# Puerto BitTorrent del qBittorrent del container (TCP+UDP). Si tu ISP filtra
# el 6881 (algunos en España), cambialo aqui y en la WebUI de qBittorrent a la
# vez, y actualiza tambien la regla de port forwarding del router y el portproxy
# de setup-lan-access.ps1.
QBITTORRENT_BT_PORT=46881
# FlareSolverr NO expone puertos al host por diseño (accesible solo en la red
# interna `multimedia-net`).

# --- Integración entre servicios ----------------------------------------------
# Lo usan los *Arr cuando llaman a Jackett / FlareSolverr.
# URL interna del agregador de indexadores (resuelta por la red multimedia-net).
JACKETT_URL=http://jackett:9117
# URL interna del proxy Cloudflare (FlareSolverr).
FLARESOLVERR_URL=http://flaresolverr:8191

# --- Tracearr ------------------------------------------------------------------
# Claim tokens. Se generan la primera vez arrancando Jellyfin/Sonarr y se pegan
# aquí. Tras un reinicio Tracearr deja de pedir el token si ya está conectado.
# Déjalos vacíos la primera vez; consígelos como explica el README y reinicia.
JELLYFIN_CLAIM_TOKEN=
SONARR_CLAIM_TOKEN=

# JWT_SECRET firma las sesiones de Tracearr. Debe ser una cadena aleatoria
# larga (>=32 chars). Genera una con:
#   openssl rand -hex 32
# VACÍO = el stack NO arrancará hasta que lo rellenes (fail-fast).
TRACEARR_JWT_SECRET=
# Password para la DB PostgreSQL que usa Tracearr.
# VACÍO = el stack NO arrancará hasta que lo rellenes (fail-fast).
TRACEARR_DB_PASSWORD=

# --- Readarr (mirror de metadatos) --------------------------------------------
# El proyecto original está archivado. Usamos el mirror `rreading-glasses`.
READARR_METADATA_SOURCE=rreading-glasses
# Solo si el mirror requiere una URL personalizada. Por defecto vacío.
READARR_METADATA_URL=
